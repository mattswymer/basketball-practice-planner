{
  "name": "Basketball Practice Planner",
  "short_name": "Practice",
  "description": "Plan and run basketball practices offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f2f5f6",
